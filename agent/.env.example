# Generate a strong secret: openssl rand -hex 32
VPS_AGENT_TOKEN=replace-with-a-long-random-secret
VPS_AGENT_HOST=127.0.0.1
VPS_AGENT_PORT=8787
# Exact browser origin of the panel (scheme + hostname + optional port).
VPS_AGENT_ORIGIN=https://your-panel.example.com
# Agent working directory is agent/; ../sites resolves to repo-root/sites.
VPS_SITES_ROOT=../sites

# Maximum concurrent authenticated PTY sessions (1–10; default 2).
VPS_MAX_TERMINAL_SESSIONS=2

# File manager root (defaults to ./sites). Keep outside system paths.
VPS_FILES_ROOT=../sites
