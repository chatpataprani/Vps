[Unit]
Description=Vps Next.js Control Panel
After=network.target vps-agent.service
Wants=vps-agent.service

[Service]
Type=simple
User=vpsagent
Group=vpsagent
WorkingDirectory=/opt/vps
EnvironmentFile=/etc/vps/panel.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Safe default. Set PANEL_BIND_IP to the VPS Tailscale IPv4 for phone access.
Environment=PANEL_BIND_IP=127.0.0.1
ExecStart=/usr/bin/npm start -- --hostname ${PANEL_BIND_IP} --port ${PORT}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/vps

[Install]
WantedBy=multi-user.target
